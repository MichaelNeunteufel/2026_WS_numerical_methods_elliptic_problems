   "source": [
    "# NGSolve and WebGUI check\n",
    "\n",
    "Run the following cell. A triangular mesh of the unit square should appear below it."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "draw-mesh",
   "metadata": {},
   "outputs": [],
   "source": [
    "from netgen.geom2d import unit_square\n",
    "from ngsolve import Mesh\n",
    "from ngsolve.webgui import Draw\n",
    "\n",
    "mesh = Mesh(unit_square.GenerateMesh(maxh=0.2))\n",
    "Draw(mesh);"
   ]
  }
